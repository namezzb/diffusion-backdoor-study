{
  "goal": "Generate and score clean SD1.5 controls for the MasqLoRA output audit",
  "compute": "managed_gpu",
  "guard": ["{python}", "{run}/evaluation/bridge.py", "guard", "{run}"],
  "command": ["{python}", "{run}/evaluation/bridge.py", "run", "{run}"],
  "cleanup": ["{python}", "{run}/evaluation/bridge.py", "cleanup", "{run}"],
  "metric": {"name": "controls", "direction": "max", "min_delta": 0},
  "max_attempts": 4,
  "max_seconds": 12600,
  "attempt_timeout": 3600
}
